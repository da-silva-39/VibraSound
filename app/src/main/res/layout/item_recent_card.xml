<?xml version="1.0" encoding="utf-8"?>
<!-- Cartao horizontal usado nas secoes "recentes" e "favoritos" do inicio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="130dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_sm"
    android:background="@drawable/bg_card_clickable"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/space_sm">

    <ImageView
        android:id="@+id/card_art"
        android:layout_width="match_parent"
        android:layout_height="114dp"
        android:background="@drawable/bg_artwork"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_small"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
