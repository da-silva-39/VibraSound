<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal (escuro). Base nativa do Android, sem AppCompat. -->
    <style name="Theme.VibraSound" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:colorPrimary">@color/accent_orange</item>
        <item name="android:colorPrimaryDark">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent_orange</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/accent_orange</item>
        <item name="android:colorControlHighlight">#33FF7A1A</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Tema claro opcional (ativado nas definicoes). -->
    <style name="Theme.VibraSound.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="android:colorPrimary">@color/accent_orange</item>
        <item name="android:colorPrimaryDark">@color/accent_orange_dark</item>
        <item name="android:colorAccent">@color/accent_orange</item>
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
        <item name="android:statusBarColor">@color/accent_orange_dark</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorControlActivated">@color/accent_orange</item>
    </style>

    <!-- Textos -->
    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.ScreenTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Texto base (os estilos Text.* herdam deste). -->
    <style name="Text" />

    <style name="Text.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Text.SectionHeader">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cartoes -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <style name="Card.Clickable">
        <item name="android:background">@drawable/bg_card_clickable</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Botoes de icone redondos -->
    <style name="IconButton">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:layout_width">@dimen/control_button_small</item>
        <item name="android:layout_height">@dimen/control_button_small</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="IconButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:layout_width">@dimen/control_button</item>
        <item name="android:layout_height">@dimen/control_button</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Campo de pesquisa / input -->
    <style name="InputField">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:padding">@dimen/space_md</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Chip / pill -->
    <style name="Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Dialog.VibraSound" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent_orange</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

</resources>
